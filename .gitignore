# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Practica 5 — credenciales locales del chart (nunca versionar)
values.secret.yaml
**/values.secret.yaml

# Practica 5 — las dependencias resueltas del chart si se versionan.
# La regla general "*.tgz" de arriba las excluiria, pero conviene incluirlas
# para que el chart se pueda instalar sin depender de que el repositorio de
# Bitnami siga disponible. Chart.lock fija sus versiones exactas.
!P5/charts/sa-platform/charts/*.tgz

# Practica 6 — dependencias resueltas del chart (misma razon que en P5).
!P6/charts/sa-platform/charts/*.tgz

# Practica 6 — artefactos locales de ejecucion (nunca versionar)
P6/.kube/
P6/.direccion-publica
P6/.image-tag

# ------------------------------------------------------------------------------
# Python — artefactos de ejecucion y de pruebas
# Los entornos virtuales los crea scripts/pruebas-locales.sh, uno por servicio,
# y no deben versionarse: se reconstruyen desde requirements.txt.
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# ------------------------------------------------------------------------------
# Practica 8 - Terraform
# El estado contiene identificadores de la cuenta de AWS y, potencialmente,
# valores sensibles de los recursos gestionados: nunca se versiona.
# ------------------------------------------------------------------------------
P8/terraform/**/.terraform/
P8/terraform/**/.terraform.lock.hcl
P8/terraform/**/terraform.tfstate
P8/terraform/**/terraform.tfstate.*
P8/terraform/**/*.tfvars
!P8/terraform/**/*.tfvars.example
P8/terraform/**/crash.log
P8/terraform/**/.terraform.tfstate.lock.info
