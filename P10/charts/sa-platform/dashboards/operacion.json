{
  "title": "Biblioteca: operación (señales de oro)",
  "uid": "sa-p10-operacion",
  "tags": [
    "p10",
    "slo",
    "senales-de-oro"
  ],
  "description": "Práctica 10, María José Tebalán Sánchez, 202100265. Cada fila responde una pregunta de operación.",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "constant",
        "query": "sa-p8",
        "hide": 2
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Alertas SLO",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertname=~\"SLO.*\",alertstate=\"firing\"}",
        "titleFormat": "{{alertname}}",
        "step": "30s"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "¿Estamos cumpliendo lo que prometimos a los usuarios? (SLO, ventana 30 días)",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Disponibilidad (objetivo 99.5%)",
      "description": "Fracción de peticiones de usuario sin error 5xx en los últimos 30 días, medida en el gateway.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - slo:sli_errores:ratio_rate30d{slo=\"disponibilidad\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Rapidez (objetivo 95% en menos de 300 ms)",
      "description": "Fracción de peticiones de usuario respondidas en menos de 300 ms en los últimos 30 días.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
