      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:sli_errores:ratio_rate1h{slo=\"disponibilidad\"} / 0.005",
          "legendFormat": "disponibilidad",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
