# syntax=docker/dockerfile:1

FROM python:3.12-slim AS deps

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        libpq-dev \
        python3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

COPY requirements.txt ./

RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

FROM python:3.12-slim AS build

WORKDIR /usr/src/app

COPY --from=deps /install /usr/local
COPY . .

RUN python -m compileall -q .

FROM python:3.12-slim AS prod

RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8000

RUN groupadd --gid 1000 appuser \
    && useradd --uid 1000 --gid 1000 --no-create-home --shell /usr/sbin/nologin appuser

WORKDIR /usr/src/app

COPY --from=deps /install /usr/local
COPY --from=build --chown=appuser:appuser /usr/src/app/main.py ./
COPY --from=build --chown=appuser:appuser /usr/src/app/src ./src

USER appuser

EXPOSE 8000

CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT} --log-level ${LOG_LEVEL:-info}"]
